def buka_kalkulator():
    kalk = tk.Toplevel(root)
    kalk.title("Kalkulator")
    kalk.geometry("300x380")
    kalk.resizable(False, False)
    kalk.configure(bg=WARNA_LATAR)
    kalk.transient(root)
    kalk.grab_set()
    ekspresi = tk.StringVar()

    def tekan(t): ekspresi.set(ekspresi.get() + str(t))
    def hitung_kalk():
        try: ekspresi.set(str(eval(ekspresi.get())))
        except: ekspresi.set("Error")
    def bersih(): ekspresi.set("")
    def pakai():
        v = ekspresi.get()
        if v and v != "Error":
            e_pokok.delete(0, tk.END)
            e_pokok.insert(0, v)
            kalk.destroy()

    ttk.Entry(kalk, textvariable=ekspresi, font=("Arial",18), justify="right").pack(fill="x", padx=10, pady=10)
    f_btn = tk.Frame(kalk, bg=WARNA_LATAR)
    f_btn.pack(padx=5, pady=5)
    tombol = [
        ("7",1,0),("8",1,1),("9",1,2),("/",1,3),
        ("4",2,0),("5",2,1),("6",2,2),("*",2,3),
        ("1",3,0),("2",3,1),("3",3,2),("-",3,3),
        ("0",4,0),(".",4,1),("=",4,2),("+",4,3),
    ]
    for txt, brs, klm in tombol:
        if txt == "=":
            t = tk.Button(f_btn, text=txt, width=5, font=("Arial",14,"bold"),
                          bg=WARNA_UTAMA, fg="white", command=hitung_kalk)
        elif txt in "+-*/":
            t = tk.Button(f_btn, text=txt, width=5, font=("Arial",14),
                          bg=WARNA_SEKUNDER, fg="white", command=lambda t=txt: tekan(t))
        else:
            t = tk.Button(f_btn, text=txt, width=5, font=("Arial",14),
                          bg="#FFFFFF", fg="#333333", command=lambda t=txt: tekan(t))
        t.grid(row=brs, column=klm, padx=3, pady=3)
    tk.Button(f_btn, text="📥 PAKAI", width=10, font=("Arial",10,"bold"),
              bg=WARNA_SEKUNDER, fg="white", command=pakai).grid(row=5, column=0, columnspan=2, padx=3, pady=5)
    tk.Button(f_btn, text="C", width=10, font=("Arial",12,"bold"),
              bg="#D32F2F", fg="white", command=bersih).grid(row=5, column=2, columnspan=2, padx=3, pady=5)

