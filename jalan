def deteksi_kategori(nama_produk, platform):
    teks = nama_produk.lower().strip()
    if not teks:
        return "Pilih Kategori"
    daftar_kategori = list(BIAYA_PLATFORM[platform]["kategori"].keys())
    for kat in daftar_kategori:
        if kat in KATA_KUNCI:
            for k in KATA_KUNCI[kat]:
                if k in teks:
                    return kat
    return daftar_kategori[-1]

