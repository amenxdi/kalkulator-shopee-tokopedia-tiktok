# FUNGSI HITUNG
# ==============================================
def hitung():
    global hasil_teks
    try:
        nama_produk = e_nama.get().strip() or "Produk Tanpa Nama"
        plat = var_platform.get()
        if plat not in BIAYA_PLATFORM:
            messagebox.showwarning("Peringatan", "Pilih Platform dulu!")
            return
        
        def ubah_angka(s): return float(s.strip().replace(',', '.')) if s.strip() else 0.0
        
        pokok = ubah_angka(e_pokok.get())
        jml_str = e_jml.get().strip()
        jml = int(jml_str) if jml_str else 1
        if jml <= 0:
            raise ValueError("Jumlah harus > 0")
        untung = ubah_angka(e_untung.get())
        
        lay_p = ubah_angka(entry_lay_p.get())
        lay_t = ubah_angka(entry_lay_t.get())
        tra_p = ubah_angka(entry_tra.get())
        ppn_p = ubah_angka(entry_ppn.get())

        total_persen = lay_p + tra_p + ppn_p
        if total_persen >= 100:
            messagebox.showerror("Salah", "Total persentase tidak boleh 100% atau lebih!")
            return
        
        total_modal = pokok * jml
        target_bersih = total_modal + untung
        harga_total = (target_bersih + lay_t) / (1 - total_persen / 100)
        harga_satuan = harga_total / jml

        biaya_lay = harga_total * (lay_p / 100) + lay_t
        biaya_tra = harga_total * (tra_p / 100)
        biaya_ppn = harga_total * (ppn_p / 100)
        potong = biaya_lay + biaya_tra + biaya_ppn
        diterima = harga_total - potong

        hasil_teks = (
            f"{'='*40}\n"
            f"    KALKULASI HARGA {plat.upper()}\n"
            f"{'='*40}\n"
            f"Nama Produk    : {nama_produk}\n"
            f"Platform       : {plat}\n"
            f"Jenis Toko     : {var_toko.get()}\n"
            f"Kategori       : {var_kategori.get()}\n"
            f"{'-'*40}\n"
            f"Harga Pokok    : Rp {pokok:,.0f}\n"
            f"Jumlah Barang  : {jml}\n"
            f"Keuntungan     : Rp {untung:,.0f}\n"
            f"{'-'*40}\n"
            f"Harga Jual Total : Rp {harga_total:,.0f}\n"
            f"Harga Jual Satuan: Rp {harga_satuan:,.0f}\n"
            f"{'-'*40}\n"
            f"Total Modal     : Rp {total_modal:,.0f}\n"
            f"Biaya Layanan   : Rp {biaya_lay:,.0f}  ({lay_p:.2f}% + Rp {lay_t:,.0f})\n"
            f"Biaya Transaksi : Rp {biaya_tra:,.0f}  ({tra_p:.2f}%)\n"
            f"PPN             : Rp {biaya_ppn:,.0f}  ({ppn_p:.2f}%)\n"
            f"Total Potongan  : Rp {potong:,.0f}\n"
            f"{'-'*40}\n"
            f"✅ DITERIMA KE REKENING : Rp {diterima:,.0f}\n"
            f"{'='*40}\n"
        )

        buka_jendela_hasil()

    except ValueError as er:
        messagebox.showerror("Input Salah", f"Masukkan angka yang valid!\nGunakan titik untuk desimal.\nKesalahan: {er}")

def salin_hasil():
    if hasil_teks:
        root.clipboard_clear()
        root.clipboard_append(hasil_teks)
        messagebox.showinfo("Berhasil ✅", "Hasil telah disalin!")
    else:
        messagebox.showwarning("Belum Ada Hasil", "Silakan tekan HITUNG dulu!")

