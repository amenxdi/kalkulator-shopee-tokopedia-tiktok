def simpan_ke_daftar():
    produk = {
        "nama": e_nama.get().strip() or "Produk Tanpa Nama",
        "platform": var_platform.get(),
        "toko": var_toko.get(),
        "kategori": var_kategori.get(),
        "pokok": e_pokok.get(),
        "jumlah": e_jml.get(),
        "untung": e_untung.get(),
        "hasil": hasil_teks
    }
    daftar_produk.append(produk)
    perbarui_listbox()
    messagebox.showinfo("Tersimpan ✅", "Produk telah ditambahkan ke daftar!")

def perbarui_listbox():
    list_produk.delete(0, tk.END)
    for i, p in enumerate(daftar_produk, 1):
        list_produk.insert(tk.END, f"{i}. [{p['platform']}] {p['nama']}")

def muat_ke_formulasi(event):
    idx = list_produk.curselection()
    if not idx:
        return
    p = daftar_produk[idx[0]]
    e_nama.delete(0, tk.END); e_nama.insert(0, p["nama"])
    var_platform.set(p["platform"])
    root.update()
    var_toko.set(p["toko"])
    var_kategori.set(p["kategori"])
    e_pokok.delete(0, tk.END); e_pokok.insert(0, p["pokok"])
    e_jml.delete(0, tk.END); e_jml.insert(0, p["jumlah"])
    e_untung.delete(0, tk.END); e_untung.insert(0, p["untung"])

def hapus_dari_daftar():
    idx = list_produk.curselection()
    if not idx:
        messagebox.showwarning("Peringatan", "Pilih produk yang akan dihapus!")
        return
    if messagebox.askyesno("Konfirmasi", "Yakin ingin menghapus produk ini?"):
        del daftar_produk[idx[0]]
        perbarui_listbox()

def simpan_ke_berkas():
    if not daftar_produk:
        messagebox.showwarning("Kosong", "Belum ada data untuk disimpan!")
        return
    berkas = filedialog.asksaveasfilename(
        defaultextension=".json",
        filetypes=[("Berkas Data", "*.json"), ("Semua Berkas", "*.*")],
        initialfile=FILE_SIMPANAN
    )
    if not berkas:
        return
    try:
        with open(berkas, "w", encoding="utf-8") as f:
            json.dump(daftar_produk, f, ensure_ascii=False, indent=2)
        messagebox.showinfo("Tersimpan ✅", f"Data disimpan di:\n{berkas}")
    except Exception as e:
        messagebox.showerror("Gagal", f"Gagal menyimpan: {e}")

def muat_dari_berkas():
    berkas = filedialog.askopenfilename(
        filetypes=[("Berkas Data", "*.json"), ("Semua Berkas", "*.*")]
    )
    if not berkas:
        return
    try:
        with open(berkas, "r", encoding="utf-8") as f:
            data = json.load(f)
        daftar_produk.clear()
        daftar_produk.extend(data)
        perbarui_listbox()
        messagebox.showinfo("Berhasil ✅", f"Dimuat {len(daftar_produk)} produk!")
    except Exception as e:
        messagebox.showerror("Gagal", f"Gagal memuat: {e}")

def ekspor_teks():
    if not daftar_produk:
        messagebox.showwarning("Kosong", "Belum ada data!")
        return
    berkas = filedialog.asksaveasfilename(
        defaultextension=".txt",
        filetypes=[("Berkas Teks", "*.txt"), ("Semua Berkas", "*.*")],
        initialfile="daftar_harga.txt"
    )
    if not berkas:
        return
    try:
        with open(berkas, "w", encoding="utf-8") as f:
            for p in daftar_produk:
                f.write(p["hasil"] + "\n")
        messagebox.showinfo("Tersimpan ✅", f"Diekspor ke:\n{berkas}")
    except Exception as e:
        messagebox.showerror("Gagal", f"Gagal mengekspor: {e}")

